# Secrets and local environment — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.*

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local runtime, caches, build output and scratch state
var/
tmp/
.tmp/
.cache/
*.log

# Note: language- and tool-specific ignore rules are deliberately omitted.
# They belong with the toolchain that IMPLEMENTATION_BLUEPRINT.md selects,
# and are added when that toolchain is actually introduced.
