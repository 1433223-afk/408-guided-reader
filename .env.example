# Development/testing overrides only. The normal product path reads the API key
# from Windows Credential Manager target: 408-guided-reader-deepseek
GUIDED_READER_DEEPSEEK_API_KEY=
GUIDED_READER_DEEPSEEK_DISABLED=0
GUIDED_READER_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
GUIDED_READER_DEEPSEEK_MODEL=deepseek-chat
GUIDED_READER_DEEPSEEK_TEMPERATURE=0.2
GUIDED_READER_DEEPSEEK_MAX_TOKENS=900
GUIDED_READER_DEEPSEEK_TIMEOUT_SECONDS=45
