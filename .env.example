# Development/testing overrides only. The normal product path reads API keys
# from the fixed Windows Credential Manager targets shown below.
GUIDED_READER_ASSISTANT_PROVIDER=deepseek
GUIDED_READER_MASTER_PROVIDER=deepseek
# Review uses this exact configured route; there is no silent provider fallback.
GUIDED_READER_REVIEW_PROVIDER=zhipu
GUIDED_READER_PROVIDER_BAKEOFF=0

# Section Guide generation: Gemini 3.8 Flash via OpenRouter, with high reasoning.
# Explicit provider/model overrides remain authoritative.
GUIDED_READER_SYSTEM_PROVIDER=openrouter
# Review stays a separate fresh-context call via GUIDED_READER_REVIEW_PROVIDER.

# Credential target: 408-guided-reader-deepseek
GUIDED_READER_DEEPSEEK_API_KEY=
GUIDED_READER_DEEPSEEK_DISABLED=0
GUIDED_READER_DEEPSEEK_ENDPOINT=https://api.deepseek.com/chat/completions
# DeepSeek V4.1 Flash uses the official API alias deepseek-flash.
GUIDED_READER_DEEPSEEK_MODEL=deepseek-flash
GUIDED_READER_DEEPSEEK_TEMPERATURE=0.2
GUIDED_READER_DEEPSEEK_MAX_TOKENS=4096
GUIDED_READER_DEEPSEEK_TIMEOUT_SECONDS=120

# Credential target: 408-guided-reader-zhipu
GUIDED_READER_ZHIPU_API_KEY=
GUIDED_READER_ZHIPU_DISABLED=0
GUIDED_READER_ZHIPU_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
GUIDED_READER_ZHIPU_MODEL=GLM-5.3-Flash
GUIDED_READER_ZHIPU_TEMPERATURE=0.2
GUIDED_READER_ZHIPU_MAX_TOKENS=4096
GUIDED_READER_ZHIPU_TIMEOUT_SECONDS=120

# Credential target: 408-guided-reader-openrouter
GUIDED_READER_OPENROUTER_API_KEY=
GUIDED_READER_OPENROUTER_DISABLED=0
GUIDED_READER_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
GUIDED_READER_OPENROUTER_MODEL=google/gemini-3.8-flash
# Optional explicit override. When empty on Windows, the enabled current-user
# Internet Settings proxy is used. Non-local OpenRouter calls fail closed if
# neither route is available; they never fall back to direct egress.
GUIDED_READER_OPENROUTER_PROXY=
GUIDED_READER_OPENROUTER_TEMPERATURE=0.2
GUIDED_READER_OPENROUTER_MAX_TOKENS=900
GUIDED_READER_OPENROUTER_TIMEOUT_SECONDS=45

# Reading Guide author/formatter only; independent Review/Assistant keep their models.
# With no model override configured, OpenRouter Guide generation uses this model.
GUIDED_READER_GUIDE_MODEL=openai/gpt-6-astra

# Direct Inline Teaching generator only; independent Review uses its existing route.
GUIDED_READER_INLINE_MODEL=google/gemini-3.8-flash
